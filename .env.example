# Telegram Bot (aiogram)
BOT_TOKEN=
ADMIN_IDS=[123456789]

# Telethon userbot
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION=simurg

# Destination channel (negative integer for supergroups/channels)
DEST_CHANNEL_ID=

# Groq (LLM for processing)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI — only needed if ENABLE_EMBEDDING_DEDUP=true
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Gemini — live per-post card background generation (image_gen.py)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# PostgreSQL
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://simurg:changeme@db:5432/simurg
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://redis:6379/0
DEDUP_TTL_SECONDS=2592000

# Processing
PROCESSOR_INTERVAL_SECONDS=30
PUBLISHER_POLL_SECONDS=60

# Feature flags
ENABLE_EMBEDDING_DEDUP=false
SIMILARITY_THRESHOLD=0.92

# Environment
ENVIRONMENT=production
