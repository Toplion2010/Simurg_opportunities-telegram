# Telegram Bot (aiogram)
BOT_TOKEN=
ADMIN_IDS=[123456789]

# Telethon userbot
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION=simurg
# Only for hosts with an ephemeral filesystem (Railway etc.), where the .session file
# is wiped on redeploy. Generate with: python -m scripts.export_session_string
# Leave empty locally to use telethon_session/<TELETHON_SESSION>.session instead.
TELETHON_SESSION_STRING=

# Destination channels — audience-based routing (negative integers for channels)
DEST_CHANNEL_ID_SCHOOL=
DEST_CHANNEL_ID_UNIVERSITY=
# Optional third channel, routed by CATEGORY on top of the two above: a
# Kazakhstan hackathon publishes here as well as to its audience channel(s).
# Leave empty or 0 to turn it off. Must be the numeric chat id, not @username.
# The BOT_TOKEN bot has to be an admin of it with "Post Messages".
DEST_CHANNEL_ID_HACKATHON=

# Groq (LLM for processing)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI — only needed if ENABLE_EMBEDDING_DEDUP=true
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Gemini — live per-post card background generation (image_gen.py)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Set false to stop paying for per-post background generation without also
# disabling ENABLE_IMAGE_ANALYSIS below (cards fall back to procedural ones).
ENABLE_LIVE_BACKGROUND=true
# Gemini vision — reads text/details from a post's attached image
GEMINI_VISION_MODEL=gemini-flash-latest
ENABLE_IMAGE_ANALYSIS=true

# PostgreSQL
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://simurg:changeme@db:5432/simurg
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://redis:6379/0
DEDUP_TTL_SECONDS=2592000

# Processing — batch runs 5x/day. UTC hours (comma-separated); 1,5,9,13,17 UTC
# = 6,10,14,18,22 Astana time (GMT+5). Adjust if your admin is in a different zone.
PROCESSOR_CRON_HOURS=1,5,9,13,17
PUBLISHER_POLL_SECONDS=60

# Web collector — scraped opportunity catalogs (src/collector/web/).
# Runs from webscan.yml; needs no API key. Seed the sources once with:
#   python -m scripts.seed_web_sources
# Items per source per run. Low on purpose: ExtracurricularHub alone lists
# ~1,760 programs, and a slow crawl keeps the admin queue reviewable and is
# kinder to two small volunteer-run sites. Override per-run with --limit.
WEB_MAX_ITEMS_PER_RUN=40
WEB_FETCH_SLEEP_SECONDS=1.0
# A paid in-person program is still admitted when the fee is at or below this
# (USD) — the "free or a small fee" limb of the admission rule.
WEB_SMALL_FEE_USD=50
# Keep false unless a token budget comes with it: routing scraped items through
# the Groq extractor would exhaust the shared free-tier daily budget and stop
# the Telegram pipeline from extracting anything.
WEB_INGEST_USE_LLM=false

# Feature flags
ENABLE_EMBEDDING_DEDUP=false
SIMILARITY_THRESHOLD=0.92

# Environment
ENVIRONMENT=production
