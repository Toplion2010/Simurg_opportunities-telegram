# Slim image for the webhook admin bot only (Koyeb free tier: 0.1 vCPU, 512MB
# RAM, 2GB disk). The full Dockerfile ships Playwright + Chromium and blows past
# both the disk cap and the CPU budget -- and this process never renders a card,
# so none of it is needed. Collection and publishing stay on GitHub Actions.
#
# Verified import surface of src/bot/** + src/db/** + src/core/config.py:
# aiogram, sqlalchemy[asyncio], asyncpg, pydantic-settings, structlog. Nothing
# else. aiohttp comes in with aiogram.
#
# Build:  docker build -f Dockerfile.bot -t simurg-bot .
# Koyeb:  set the Dockerfile path to Dockerfile.bot
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Pinned by lower bound to match pyproject; deliberately NOT `pip install .` --
# that would drag in playwright, telethon, numpy, openai and Pillow.
RUN pip install --no-cache-dir \
        "aiogram>=3.7" \
        "sqlalchemy[asyncio]>=2.0" \
        "asyncpg>=0.29" \
        "pydantic-settings>=2.3" \
        "structlog>=24.1"

COPY src/ ./src/

# Koyeb injects PORT; the app defaults to 8080 if it's absent.
EXPOSE 8080

CMD ["python", "-m", "src.routines.bot_webhook"]
